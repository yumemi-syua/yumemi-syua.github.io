---
type Props = {
  postCount: number;
  latestDate: string;
};

const { postCount, latestDate } = Astro.props;
---

<section class="blog-hero page-hero">
  <div class="blog-hero-copy">
    <p class="hero-kicker">Journal / Field Notes</p>
    <h1>Blog</h1>
    <p>配信情報、配信日程の予定などをあげています。</p>
  </div>

  <aside class="blog-hero-card" aria-label="ブログ概要">
    <img
      src="https://static-cdn.jtvnw.net/jtv_user_pictures/5cd1e68d-6b5f-4453-9da3-ab411708e6fa-profile_image-70x70.png"
      alt="しゅあのアイコン"
      width="112"
      height="112"
    />
    <dl>
      <div>
        <dt>Posts</dt>
        <dd>{postCount.toString().padStart(2, "0")}</dd>
      </div>
      <div>
        <dt>Latest</dt>
        <dd>{latestDate}</dd>
      </div>
    </dl>
  </aside>
</section>
